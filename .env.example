# .env.example — copy to .env and fill in your values
# Run: cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────
PROJECT_ID=your-gcp-project-id
BUCKET_NAME=dubbing-pipeline-your-gcp-project-id
INPUT_FILE=gs://your-bucket/input/your-video.mp4

# ── Languages ─────────────────────────────────────────────────────────────
SOURCE_LANG=ko
TARGET_LANG=en

# ── Model ─────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# ── GCP ───────────────────────────────────────────────────────────────────
GCP_REGION=us-central1

# ── Pipeline tuning ────────────────────────────────────────────────────────
MAX_ITERATIONS=3
QA_THRESHOLD=0.80
NUM_QA_AGENTS=3
QA_TEMPERATURES=0.1,0.5,0.9

# ── FFmpeg ──────────────────────────────────────────────────────────────────
# Local Homebrew ffmpeg lacks libass (needed to burn subtitles into video).
# ffmpeg-full includes it. Leave unset (defaults to "ffmpeg") on Cloud Run —
# the Debian base image's ffmpeg already includes libass.
FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg

# ── Speech-to-Text (Chirp) ─────────────────────────────────────────────────
# Cloud Speech-to-Text v2 model used for word-level, audio-anchored timestamps.
# Gemini still handles text/cultural enrichment — this only fixes timing.
STT_MODEL=chirp_2
# Secondary pass (different region — chirp_3 isn't available in us-central1)
# used only to recover words chirp_2 missed under heavy background music.
STT_FALLBACK_MODEL=chirp_3
STT_FALLBACK_REGION=us

# ── Subtitle formatting ────────────────────────────────────────────────────
MAX_CHARS_PER_LINE=42
MAX_LINES_PER_CUE=2
BURN_SUBTITLES=true
SOFT_SUBTITLES=true

# ── Optional: Vertex AI Vector Search (leave blank to use in-memory fallback) ──
VECTOR_SEARCH_INDEX_ID=
VECTOR_SEARCH_ENDPOINT_ID=

# ── Job settings ───────────────────────────────────────────────────────────
JOB_ID=local-dev
RESUME_FROM_CHECKPOINTS=false
